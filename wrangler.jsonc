{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qzenta-security-snapshot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Test network only. Never point this at a mainnet network without
    // explicit human approval — see /areas/cloudflare-wallets-agentic-commerce.md
    "X402_NETWORK": "base-sepolia",
    // Real base-sepolia testnet wallet (14 Aug 2026), generated via viem,
    // funded with 20 test USDC from Circle's faucet (confirmed on-chain via
    // direct RPC balanceOf call — see docs/agent-commerce/TESTNET-WALLET.md).
    // This is the address only — the private key is never given to the
    // Worker, since paymentMiddleware's payTo parameter only ever needs the
    // public address (confirmed against x402-hono's own type declarations).
    // Zero real monetary value. Still not the real Qzenta Virtual Wallet —
    // replace this once Cloudflare Wallets funding ships and Daniel decides
    // to go live, per /areas/cloudflare-wallets-agentic-commerce.md.
    "X402_PAY_TO": "0x1866Fd80B1196AcC70A98a50917A8FD4639FE823"
  },
  "ratelimits": [
    {
      // Free discovery endpoint — generous, but not unlimited.
      "name": "DISCOVERY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // /snapshot/* pre-payment 402 check — a spam request costs nothing
      // until payment clears, so this is tighter than the free endpoint.
      "name": "SNAPSHOT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ]
}
