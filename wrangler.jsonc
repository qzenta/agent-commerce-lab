{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qzenta-security-snapshot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Test network only. Never point this at a mainnet network without
    // explicit human approval — see /areas/cloudflare-wallets-agentic-commerce.md
    "X402_NETWORK": "base-sepolia",
    // Real base-sepolia testnet wallet (14 Aug 2026), generated via viem,
    // funded with 20 test USDC from Circle's faucet (confirmed on-chain via
    // direct RPC balanceOf call — see docs/agent-commerce/TESTNET-WALLET.md).
    // This is the address only — the private key is never given to the
    // Worker, since paymentMiddleware's payTo parameter only ever needs the
    // public address (confirmed against x402-hono's own type declarations).
    // Zero real monetary value. Still not the real Qzenta Virtual Wallet —
    // replace this once Cloudflare Wallets funding ships and Daniel decides
    // to go live, per /areas/cloudflare-wallets-agentic-commerce.md.
    "X402_PAY_TO": "0x1866Fd80B1196AcC70A98a50917A8FD4639FE823",
    // Gate 4 P0 (20 Aug 2026): domains the scheduled (cron) scan monitors via
    // the internal scan path. Pilot scope: the first paying pilot site
    // (sikatrix.com whole site). The qzenta-sitehealth-fixture testbed is NOT
    // monitored here: same-account worker->worker fetches to *.workers.dev
    // return 404 at the edge (observed in the Workers runtime; direct fetch
    // returns 200) — the fixture is exercised via staging/local verification.
    // Set ALERT_WEBHOOK_URL (optional) to a webhook/email-provider endpoint to
    // activate alert delivery.
    "MONITOR_DOMAINS": "https://www.sikatrix.com/"
  },
  "triggers": {
    // Pilot cadence: weekly, Monday 06:00 UTC. The Gate 4 verification window
    // temporarily deploys a tighter schedule, then returns to this.
    "crons": ["0 6 * * 1"]
  },
  "ratelimits": [
    {
      // Free discovery endpoint — generous, but not unlimited.
      "name": "DISCOVERY_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      // /snapshot/* pre-payment 402 check — a spam request costs nothing
      // until payment clears, so this is tighter than the free endpoint.
      "name": "SNAPSHOT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      // Cycle 2 history/change-detection store (sitehealth v2).
      // Provisioned 19 Aug 2026 via `wrangler d1 create` (region WEUR) under
      // the Qzenta account; schema applied via `wrangler d1 migrations apply`.
      "binding": "HISTORY_DB",
      "database_name": "qzenta-sitehealth-history",
      "database_id": "f75cc7c4-33a9-4e83-950f-fb7280747fe3"
    }
  ]
}
